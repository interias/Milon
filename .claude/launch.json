{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "design",
      "runtimeExecutable": "python",
      "runtimeArgs": ["design/serve.py"],
      "port": 4321
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "client", "run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "server",
      "runtimeExecutable": "server/.venv/Scripts/uvicorn.exe",
      "runtimeArgs": ["app.main:app", "--app-dir", "server", "--host", "0.0.0.0", "--port", "8000"],
      "port": 8000
    }
  ]
}
