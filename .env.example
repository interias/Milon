# Root-.env  -  nur fuer die Design-Asset-Generierung (OpenAI gpt-image-2).
# Kopiere diese Datei zu ".env" und trage deinen Schluessel ein.
# Die echte .env wird NICHT committed (siehe .gitignore).

OPENAI_API_KEY=

# Optional: weicher Kostendeckel in EUR fuer Batch-Bildgenerierung (leer = aus)
EUR_CAP=

# Optional: Tailscale-Auth-Key fuer HTTPS im eigenen Tailnet (docker compose --profile tailscale).
# Nur fuer die erste Anmeldung noetig; nicht ephemeral, pre-approved, keine Tags.
# TS_AUTHKEY=
